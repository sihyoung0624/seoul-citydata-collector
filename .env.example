# 이 파일은 "어떤 환경변수가 필요한지" 보여주는 견본입니다.
# 실제 값은 절대 여기에 쓰지 마세요.
# - GitHub Actions 실행 시: GitHub 저장소 Settings > Secrets에 등록 (README 참조)
# - 로컬 테스트 시: 이 파일을 .env로 복사해 값을 채우세요 (.env는 커밋되지 않음)

# 서울 열린데이터광장 일반 인증키
SEOUL_API_KEY=

# Supabase 프로젝트 URL (예: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Supabase service_role 키 (모든 권한 — 절대 외부 노출 금지)
SUPABASE_SERVICE_KEY=
